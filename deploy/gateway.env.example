# /etc/lacre-gateway/gateway.env, root:lacre 0640.
# Everything the gateway reads, except the signing key, which is never here
# (see lacre-gateway.service, LoadCredential).

LACRE_NETWORK=bradbury
# The Router from vendor/lacre/deployments.json ("router"). The Verifier and
# the KeyCache are resolved through it on every use; they are not set here.
LACRE_ROUTER=0xEf37cb72C3A9dD6bCE2f3575B75c94C555F9c8d9
# Comma separated, at least 24 characters each. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LACRE_API_KEYS=replace-with-a-generated-key
# Where /h/{token} is reachable from the internet. Validators fetch the
# signed headers from here while a call is in flight.
LACRE_BLOB_BASE_URL=https://lacre.in-sidr.xyz/h

# Delays, in seconds. The defaults are shown.
#LACRE_POLL_S=30
#LACRE_FINAL_BOUND_S=14400
#LACRE_MAX_ATTEMPTS=3
#LACRE_MAX_SEND_FAILURES=3
#LACRE_KEY_QUARANTINE_S=86400
#LACRE_CONFIRM_MARGIN_S=600
#LACRE_CONFIRM_RETRY_S=3600
#LACRE_WORKER_STALE_S=300
#LACRE_MAX_EML_BYTES=10485760
