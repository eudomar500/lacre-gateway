# /etc/lacre-gateway/gateway.env, root:lacre 0640.
# Everything the gateway reads, except the signing key, which is never here
# (see lacre-gateway.service, LoadCredential).

LACRE_NETWORK=bradbury
# The Router from vendor/lacre/deployments.json ("router"). The Verifier and
# the KeyCache are resolved through it on every use; they are not set here.
LACRE_ROUTER=0xEf37cb72C3A9dD6bCE2f3575B75c94C555F9c8d9
# Comma separated, at least 24 characters each. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LACRE_API_KEYS=replace-with-a-generated-key

# Accounts. Every LACRE_API_KEYS entry gets an account on start, with
# LACRE_BOOTSTRAP_CREDITS credits; 0 makes those accounts unlimited. That is
# a testnet convenience: set a number, or move customers to admin-made
# accounts, before mainnet. Taking an entry out of the list revokes its key.
#LACRE_BOOTSTRAP_CREDITS=0
# Credits a job holds per step, charged when the step writes a record.
#LACRE_PRICE_ATTEST=1
#LACRE_PRICE_EXTRACT=1
# The X-Admin-Token of /admin/*, which creates accounts and tops them up.
# Unset, the admin API answers 503. At least 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#LACRE_ADMIN_TOKEN=
# Where /h/{token} is reachable from the internet. Validators fetch the
# signed headers from here while a call is in flight.
LACRE_BLOB_BASE_URL=https://lacre.in-sidr.xyz/h
# Where /b/{name}.bin is reachable from the internet. Validators fetch the
# body of an extraction in flight from here. Defaults to LACRE_BLOB_BASE_URL
# with its last /h made /b.
#LACRE_BODY_BASE_URL=https://lacre.in-sidr.xyz/b
# What POST /attest does when the request has no extract field: none,
# patterns, llm or auto. Each extraction is one more paid transaction.
#LACRE_EXTRACT_DEFAULT=auto

# Mailboxes. Addresses are lacre-<id>@LACRE_MAIL_DOMAIN. POST /inbound is
# off until LACRE_INBOUND_SECRET is set; the Worker in deploy/worker holds
# the same value as a Worker secret. At least 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#LACRE_MAIL_DOMAIN=in-sidr.xyz
#LACRE_INBOUND_SECRET=

# Delays, in seconds. The defaults are shown.
#LACRE_POLL_S=30
#LACRE_FINAL_BOUND_S=14400
#LACRE_MAX_ATTEMPTS=3
#LACRE_MAX_SEND_FAILURES=3
#LACRE_KEY_QUARANTINE_S=86400
#LACRE_CONFIRM_MARGIN_S=600
#LACRE_CONFIRM_RETRY_S=3600
#LACRE_WORKER_STALE_S=300
#LACRE_MAX_EML_BYTES=10485760
