# /etc/cloudflared/config.yml on the VPS.
#
# The gateway listens on 127.0.0.1:8080 only; this tunnel is the one way in.
# Create the tunnel and its DNS route once:
#   cloudflared tunnel create lacre-gateway
#   cloudflared tunnel route dns lacre-gateway lacre.in-sidr.xyz
# then put the tunnel id below and run cloudflared as its own service:
#   cloudflared service install

tunnel: <TUNNEL-ID>
credentials-file: /etc/cloudflared/<TUNNEL-ID>.json

ingress:
  # The signed headers of calls in flight. No API key: the validators fetch
  # them from the URL in the attest calldata.
  - hostname: lacre.in-sidr.xyz
    path: ^/h/[A-Za-z0-9_-]{43}$
    service: http://127.0.0.1:8080
  # The API, and the MCP tools at /mcp. Every call carries X-API-Key; the
  # gateway checks it. /mcp subpaths pass so that the gateway, which routes
  # /mcp and /mcp/, answers the rest with its own 404.
  - hostname: lacre.in-sidr.xyz
    path: ^/(attest|jobs(/[0-9a-f]{32})?|records/[0-9]+|extractions/(patterns|llm)/[0-9]+|senders/[^/]+/[^/]+|mailboxes(/[a-z2-7]{12}(/jobs)?)?|account(/rotate-key)?|health|mcp(/.*)?)$
    service: http://127.0.0.1:8080
  # The web app and its access form. No API key: the pages, the favicon and
  # /static are the same for everyone and every call they make carries the
  # visitor's key; /access-request is rate limited per address by the
  # gateway. how, why, mcp and access.html only redirect to their section
  # of /, and stay routed so old links still land. /primitives is the
  # Router's reading at FINALIZED, public chain state, served from a copy
  # at most ten minutes old.
  - hostname: lacre.in-sidr.xyz
    path: ^/((how|docs|why|mcp|access)\.html|favicon\.svg|static/.+|access-request|primitives)?$
    service: http://127.0.0.1:8080
  # The admin API creates accounts and credits them. It is meant for
  # localhost (curl on the VPS against 127.0.0.1:8080), so it is not routed
  # here. Uncomment only with a Cloudflare Access application in front of
  # these paths; X-Admin-Token alone should not face the internet.
  # - hostname: lacre.in-sidr.xyz
  #   path: ^/admin/(accounts(/[a-z2-7]{12}(/(topups|disable|enable))?)?|access-requests)$
  #   service: http://127.0.0.1:8080
  # Mail for mailboxes, posted by the Email Worker (deploy/worker). No API
  # key: the gateway checks the HMAC the Worker signs it with.
  - hostname: lacre.in-sidr.xyz
    path: ^/inbound$
    service: http://127.0.0.1:8080
  # The bodies of extractions in flight, served by the gateway itself. No
  # API key: the validators fetch them from the URL in the extract calldata.
  - hostname: lacre.in-sidr.xyz
    path: ^/b/[a-f0-9]{32}\.bin$
    service: http://127.0.0.1:8080
  - service: http_status:404
